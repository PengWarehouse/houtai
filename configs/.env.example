# 复制为 configs/.env 后按需修改，程序启动时会自动加载（已存在的环境变量优先）。
APP_NAME=goProject
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=1104
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SEC=10

# MySQL 连接（本机 8.4，库名 mydb）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mydb
# 连接池
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SEC=1800
DB_CONNECT_TIMEOUT_SEC=5

# JWT：secret 至少 16 位，建议用 openssl rand -hex 32 生成；留空则启动时生成临时密钥（重启后 token 失效）
JWT_SECRET=
JWT_EXPIRE_HOURS=12

# 允许跨域访问的前端来源，多个用逗号分隔；* 表示全部放开（生产环境不建议）
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DeepSeek AI（密钥只放服务端 .env，切勿写进前端代码或提交到仓库）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SEC=60
