# 所有环境共享的变量（Vite 只会注入 VITE_ 开头的变量）
VITE_APP_TITLE=后台管理系统

# axios 基础路径：开发环境走 vite 代理，生产环境可改成完整域名
VITE_API_BASE_URL=/api
# 请求超时（毫秒）
VITE_API_TIMEOUT=15000

# 开发服务器端口
VITE_PORT=5173
# 开发代理目标（Go 后端）
VITE_PROXY_TARGET=http://127.0.0.1:1104

# 是否强制登录：路由守卫读取该值
# 后端登录接口未就绪时设为 false，可先浏览页面
VITE_REQUIRE_AUTH=false
